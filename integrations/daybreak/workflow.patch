diff --git a/.github/workflows/store-release.yml b/.github/workflows/store-release.yml
new file mode 100644
index 0000000..d46531e
--- /dev/null
+++ b/.github/workflows/store-release.yml
@@ -0,0 +1,125 @@
+name: Build signed store release
+on:
+  workflow_dispatch:
+    inputs:
+      create_draft:
+        description: Create a draft release (requires an unused version and build number)
+        required: true
+        default: false
+        type: boolean
+permissions:
+  contents: write
+concurrency:
+  group: signed-store-release
+  cancel-in-progress: false
+jobs:
+  release:
+    if: github.ref == 'refs/heads/main'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 30
+    environment: android-release
+    defaults:
+      run:
+        working-directory: .
+    steps:
+      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
+      - uses: actions/setup-java@cf277c60eb25467037889841efdb72551f06f6c3 # v4
+        with:
+          distribution: temurin
+          java-version: '17'
+      - name: Read the release version
+        run: |
+          python3 - <<'PYTHON'
+          import os,pathlib,re
+          match=re.search(r'^version:\s*(\d+\.\d+\.\d+)\+(\d+)\s*$',pathlib.Path('pubspec.yaml').read_text(),re.M)
+          if not match or int(match[2]) < 1: raise SystemExit('Use a stable semantic version and positive build number')
+          with open(os.environ['GITHUB_ENV'],'a') as f:f.write('VERSION='+match[1]+'\n')
+          PYTHON
+      - name: Refuse an existing release or tag
+        if: inputs.create_draft
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          if gh release view "v$VERSION" --repo "$GITHUB_REPOSITORY" >/dev/null 2>&1 || git ls-remote --exit-code --tags origin "refs/tags/v$VERSION" >/dev/null 2>&1; then
+            echo 'Increase the version name and build number before creating a release.' >&2
+            exit 1
+          fi
+      - name: Use the existing Flutter version
+        working-directory: .
+        run: |
+          git clone --depth 1 --branch 3.32.0-0.2.pre https://github.com/flutter/flutter.git "$RUNNER_TEMP/flutter"
+          test "$(git -C "$RUNNER_TEMP/flutter" rev-parse HEAD)" = d3abd00e69a89a615e13969c02832ef1e0119639
+          echo "$RUNNER_TEMP/flutter/bin" >> "$GITHUB_PATH"
+      - uses: android-actions/setup-android@9fc6c4e9069bf8d3d10b2204b1fb8f6ef7065407 # v3
+        with:
+          packages: platform-tools
+          log-accepted-android-sdk-licenses: false
+      - run: sdkmanager 'platforms;android-36' 'build-tools;35.0.0' 'ndk;27.0.12077973'
+      - name: Analyze and test before loading the signing key
+        run: |
+          flutter --no-version-check pub get --enforce-lockfile
+          flutter --no-version-check analyze
+          flutter --no-version-check test
+      - name: Restore existing release key
+        env:
+          RELEASE_KEYSTORE_BASE64: ${{ secrets.RELEASE_KEYSTORE_BASE64 }}
+          RELEASE_STORE_PASSWORD: ${{ secrets.RELEASE_STORE_PASSWORD }}
+          RELEASE_KEY_ALIAS: ${{ secrets.RELEASE_KEY_ALIAS }}
+          RELEASE_KEY_PASSWORD: ${{ secrets.RELEASE_KEY_PASSWORD }}
+          RELEASE_KEYSTORE: ${{ runner.temp }}/release.jks
+        run: |
+          : "${RELEASE_KEYSTORE_BASE64:?Configure the existing release keystore in the android-release environment}"
+          : "${RELEASE_STORE_PASSWORD:?Missing keystore password}"
+          : "${RELEASE_KEY_PASSWORD:?Missing key password}"
+          : "${RELEASE_KEY_ALIAS:?Missing key alias}"
+          printf '%s' "$RELEASE_KEYSTORE_BASE64" | base64 --decode > "$RELEASE_KEYSTORE"
+          chmod 600 "$RELEASE_KEYSTORE"
+          python3 - <<'PYTHON'
+          import os, pathlib
+          p=pathlib.Path('android/key.properties')
+          def escaped(value): return value.replace('\\', '\\\\').replace('\n', '\\n').replace('\r', '\\r')
+          p.write_text('\n'.join(k+'='+escaped(os.environ[v]) for k,v in [('storeFile','RELEASE_KEYSTORE'),('storePassword','RELEASE_STORE_PASSWORD'),('keyAlias','RELEASE_KEY_ALIAS'),('keyPassword','RELEASE_KEY_PASSWORD')])+'\n')
+          p.chmod(0o600)
+          PYTHON
+      - name: Build signed APK
+        run: flutter --no-version-check build apk --release --target-platform android-arm64
+      - name: Remove signing material
+        if: always()
+        run: |
+          rm -f "$RUNNER_TEMP/release.jks" android/key.properties
+      - name: Verify APK and prepare release
+        run: |
+          APK=build/app/outputs/flutter-apk/app-release.apk
+          "$ANDROID_HOME/build-tools/35.0.0/apksigner" verify --verbose --print-certs "$APK" > "$RUNNER_TEMP/apk-cert.txt"
+          "$ANDROID_HOME/build-tools/35.0.0/aapt2" dump badging "$APK" > "$RUNNER_TEMP/apk-package.txt"
+          python3 - <<'PYTHON'
+          import os,pathlib,re
+          version=re.search(r'^version:\s*(\S+)\+(\d+)', pathlib.Path('pubspec.yaml').read_text(), re.M)
+          if not version: raise SystemExit('pubspec.yaml needs a version name and increasing build number')
+          certs=re.findall(r'^Signer #\d+ certificate SHA-256 digest: (\w+)$',pathlib.Path(os.environ['RUNNER_TEMP']+'/apk-cert.txt').read_text(),re.M)
+          if certs != ['18cb4dbf5d8b3ed41336acd2c1f6dc12bd7aba2d8f5a6dcaf9339e42b6af683a']: raise SystemExit('Wrong signing key; keep the original release certificate')
+          info=pathlib.Path(os.environ['RUNNER_TEMP']+'/apk-package.txt').read_text()
+          match=re.search(r"package: name='([^']+)' versionCode='(\d+)' versionName='([^']+)'",info)
+          if not match or (match[1],match[2],match[3]) != ('dev.jeeth.local_weather', version[2],version[1]): raise SystemExit('APK package or version mismatch')
+          with open(os.environ['GITHUB_ENV'],'a') as f:f.write('VERSION='+version[1]+'\n')
+          PYTHON
+      - name: Stage verified APK and checksums
+        run: |
+          mkdir -p "$RUNNER_TEMP/dist"
+          cp build/app/outputs/flutter-apk/app-release.apk "$RUNNER_TEMP/dist/daybreak-android-arm64.apk"
+          cd "$RUNNER_TEMP/dist"
+          sha256sum *.apk > SHA256SUMS
+      - name: Save the verified signed build
+        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
+        with:
+          name: daybreak-signed-android-${{ env.VERSION }}-${{ github.run_id }}
+          path: ${{ runner.temp }}/dist/*
+          if-no-files-found: error
+          retention-days: 14
+      - name: Create a draft release for review
+        if: inputs.create_draft
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          cd "$RUNNER_TEMP/dist"
+          gh release create "v$VERSION" --repo "$GITHUB_REPOSITORY" --target "$GITHUB_SHA" --draft --title "v$VERSION" --generate-notes ./*.apk SHA256SUMS
