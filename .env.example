STORE_DOMAIN=store.example.com
ADMIN_TOKEN=
WEBHOOK_SECRET=
# Optional for public repositories; required for private repositories (read contents only).
GITHUB_TOKEN=

# Optional app notifications; use a separate random server-only service key.
