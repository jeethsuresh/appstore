{
  "name": "private-store",
  "productName": "Bazaar",
  "version": "0.1.13",
  "versionCode": 14,
  "description": "Your Gravitas apps for desktop",
  "author": "Jeeth Suresh",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "playwright test",
    "package": "electron-builder --publish never",
    "package:flatpak": "electron-builder --linux flatpak --x64 --publish never"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "cool.gravitas.privatestore",
    "artifactName": "PrivateStore-${version}-${os}-${arch}.${ext}",
    "files": [
      "*.cjs",
      "ui/**",
      "node_modules/**",
      "!test/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "toolsets": {
      "appimage": "1.0.3"
    },
    "mac": {
      "asar": false,
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "sign": "./macos-sign.cjs"
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "private-store"
    },
    "flatpak": {
      "runtime": "org.freedesktop.Platform",
      "runtimeVersion": "25.08",
      "sdk": "org.freedesktop.Sdk",
      "base": "org.electronjs.Electron2.BaseApp",
      "baseVersion": "25.08",
      "branch": "stable",
      "useWaylandFlags": true,
      "finishArgs": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--share=network",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.secrets",
        "--talk-name=org.kde.kwalletd5",
        "--talk-name=org.kde.kwalletd6",
        "--filesystem=xdg-data/applications:create",
        "--filesystem=xdg-data/Gravitas:create"
      ]
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "icon": "assets/icon.png"
  }
}
