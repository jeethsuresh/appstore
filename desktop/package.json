{
  "name": "private-store",
  "productName": "Private Store",
  "version": "0.1.1",
  "versionCode": 2,
  "description": "Your Gravitas apps for desktop",
  "author": "Jeeth Suresh",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:e2e": "playwright test",
    "package": "electron-builder --publish never"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "@playwright/test": "1.64.1"
  },
  "build": {
    "appId": "cool.gravitas.privatestore",
    "artifactName": "PrivateStore-${version}-${os}-${arch}.${ext}",
    "files": [
      "*.cjs",
      "ui/**",
      "node_modules/**",
      "!test/**",
      "assets/**"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": "-"
    },
    "win": {
      "target": [
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "executableName": "private-store"
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ],
    "icon": "assets/icon.png"
  }
}
